{
	"name": "cmd-mod-better-sub-agents",
	"version": "2.0.0",
	"description": "Command Code mod: async subagents that run detached and signal their result back to the session that spawned them",
	"type": "module",
	"license": "MIT",
	"author": "Prem Modha",
	"keywords": [
		"cmd-mod",
		"command-code",
		"subagents",
		"async-agents",
		"pubsub"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/PremModhaOfficial/cmd-mod-pubsub.git"
	},
	"homepage": "https://github.com/PremModhaOfficial/cmd-mod-pubsub#readme",
	"bugs": {
		"url": "https://github.com/PremModhaOfficial/cmd-mod-pubsub/issues"
	},
	"files": [
		"better-sub-agents.ts",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "node scripts/build.mjs",
		"check": "npm run build && node scripts/check-stale.mjs",
		"check:imports": "node scripts/check-imports.mjs",
		"gate": "npm run check && npm run typecheck && npm run check:imports && node test/bundle.mjs && npm run test:scripts && npm test",
		"test": "node test/smoke.mjs",
		"test:scripts": "node test/extract-region.mjs",
		"test:e2e": "node test/e2e.mjs",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"esbuild": "^0.25.12",
		"typescript": "^5.7.0"
	},
	"engines": {
		"node": ">=22.18"
	}
}
